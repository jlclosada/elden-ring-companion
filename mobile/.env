# El código compartido con la web (../src) usa import() para cargar los JSON del compendio y del mapa.
# Metro no sabe servir esos fragmentos diferidos fuera de la carpeta de la app, así que se empaquetan
# en el bundle principal (igual que en producción).
EXPO_NO_METRO_LAZY=1
# Servidor de las teselas del mapa (por defecto: http://<ip del ordenador>:8090, el contenedor web)
# EXPO_PUBLIC_TILES_URL=http://192.168.1.49:8090
